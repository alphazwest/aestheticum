{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alphazwest/aesthetics/blob/master/schema/design-styles.schema.json",
  "title": "Aesthetics dataset",
  "type": "object",
  "required": [
    "schema_version",
    "source_tiers",
    "domains",
    "alias_sources",
    "tags",
    "styles"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source_tiers": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "1",
          "2",
          "3"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "domains": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "$ref": "#/$defs/domain"
      }
    },
    "alias_sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "url",
          "space"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "type": "string",
            "pattern": "^https://\\S*\\{ref\\}\\S*$"
          },
          "space": {
            "enum": [
              "_",
              "-",
              "+",
              "%20"
            ]
          }
        }
      }
    },
    "tags": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/style"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "tier"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "publisher": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "tier": {
          "enum": [
            1,
            2,
            3
          ]
        }
      }
    },
    "domain_expression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "markers": {
          "$ref": "#/$defs/text"
        },
        "media_markers": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/slug"
          },
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "id",
        "name",
        "parent",
        "description",
        "tags",
        "sources",
        "domains"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/slug"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "sources": {
          "allOf": [
            {
              "$ref": "#/$defs/sources"
            },
            {
              "maxItems": 4
            }
          ]
        },
        "domains": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/slug"
          },
          "additionalProperties": {
            "$ref": "#/$defs/domain_expression"
          },
          "minProperties": 1
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/variant"
          }
        },
        "ids": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "aat": {
              "type": "string",
              "pattern": "^3[0-9]{8}$"
            },
            "wikidata": {
              "type": "string",
              "pattern": "^Q[0-9]+$"
            }
          }
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "sources"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "source",
                    "ref"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "$ref": "#/$defs/slug"
                    },
                    "ref": {
                      "$ref": "#/$defs/text"
                    }
                  }
                }
              }
            }
          }
        },
        "popularity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "design_demand"
          ],
          "properties": {
            "score": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "design_demand": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "domain": {
      "type": "object",
      "required": [
        "name",
        "description",
        "aat",
        "media"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "aat": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^3[0-9]{8}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "media": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      },
      "contains": {
        "type": "object",
        "properties": {
          "tier": {
            "enum": [
              1,
              2
            ]
          }
        },
        "required": [
          "tier"
        ]
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "name",
        "description",
        "markers",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "markers": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "sources": {
          "allOf": [
            {
              "$ref": "#/$defs/sources"
            },
            {
              "maxItems": 4
            }
          ]
        }
      }
    }
  }
}
