{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alphazwest/aestheticum/blob/master/schema/aestheticum.schema.json",
  "title": "Aestheticum",
  "description": "A faceted, sourced vocabulary of visual aesthetics: shared vocabularies and one section per facet.",
  "type": "object",
  "required": [
    "schema_version",
    "vocab",
    "styles",
    "techniques",
    "effects",
    "materials",
    "design_elements",
    "objects",
    "agents"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 3
    },
    "vocab": {
      "type": "object",
      "required": [
        "facets",
        "relations",
        "source_tiers",
        "domains",
        "alias_sources",
        "tags"
      ],
      "additionalProperties": false,
      "description": "The shared vocabularies.",
      "properties": {
        "facets": {
          "type": "object",
          "description": "Facet id to its definition; the ids are the facet section keys of the document.",
          "propertyNames": {
            "enum": [
              "styles",
              "techniques",
              "effects",
              "materials",
              "design_elements",
              "objects",
              "agents"
            ]
          },
          "required": [
            "styles",
            "techniques",
            "effects",
            "materials",
            "design_elements",
            "objects",
            "agents"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/facet"
          }
        },
        "relations": {
          "type": "object",
          "description": "Owning facet to its predicates.",
          "propertyNames": {
            "enum": [
              "styles",
              "techniques",
              "effects",
              "materials",
              "design_elements",
              "objects",
              "agents"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "$ref": "#/$defs/field"
            },
            "additionalProperties": {
              "$ref": "#/$defs/predicate"
            }
          }
        },
        "source_tiers": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "1",
              "2",
              "3"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/slug"
          },
          "additionalProperties": {
            "$ref": "#/$defs/domain"
          }
        },
        "alias_sources": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/slug"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "name",
              "url",
              "space"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "url": {
                "type": "string",
                "pattern": "^https://\\S*\\{ref\\}\\S*$"
              },
              "space": {
                "enum": [
                  "_",
                  "-",
                  "+",
                  "%20"
                ]
              }
            }
          }
        },
        "tags": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/slug"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/slug"
            }
          }
        }
      }
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/style"
      }
    },
    "techniques": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/technique"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "materials": {
      "$ref": "#/$defs/empty_facet"
    },
    "design_elements": {
      "$ref": "#/$defs/empty_facet"
    },
    "objects": {
      "$ref": "#/$defs/empty_facet"
    },
    "agents": {
      "$ref": "#/$defs/empty_facet"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "An id: lower-case letters and digits in hyphen-joined words."
    },
    "field": {
      "type": "string",
      "pattern": "^[a-z]+(_[a-z]+)*$",
      "description": "A field name: lower-case words joined by underscores (facet sections and relation predicates)."
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "aat_id": {
      "type": "string",
      "pattern": "^3[0-9]{8}$",
      "description": "A Getty AAT subject id."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "markers": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Observable visual features."
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "tier"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "publisher": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "tier": {
          "enum": [
            1,
            2,
            3
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      },
      "contains": {
        "type": "object",
        "properties": {
          "tier": {
            "enum": [
              1,
              2
            ]
          }
        },
        "required": [
          "tier"
        ]
      },
      "description": "Citations; at least one tier 1 or tier 2 source."
    },
    "source_list": {
      "allOf": [
        {
          "$ref": "#/$defs/sources"
        },
        {
          "maxItems": 4
        }
      ]
    },
    "tag_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      },
      "description": "1–5 tags from `vocab.tags`."
    },
    "domain": {
      "type": "object",
      "required": [
        "name",
        "description",
        "aat",
        "media"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "aat": {
          "anyOf": [
            {
              "$ref": "#/$defs/aat_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "media": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "domain_expression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "markers": {
          "$ref": "#/$defs/text"
        },
        "media_markers": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/slug"
          },
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      },
      "description": "An entry's expression in one domain: its media, markers, per-media markers and sources."
    },
    "domain_expressions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "$ref": "#/$defs/domain_expression"
      },
      "minProperties": 1,
      "description": "Domain id (from `vocab.domains`) to the entry's expression in that domain."
    },
    "variant": {
      "type": "object",
      "required": [
        "name",
        "description",
        "markers",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "markers": {
          "$ref": "#/$defs/markers"
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "sources": {
          "$ref": "#/$defs/source_list"
        }
      },
      "description": "A named nuance inside an entry (a sub-movement, a grade, a finish, a regional form); not indexed."
    },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "aat": {
          "$ref": "#/$defs/aat_id"
        },
        "wikidata": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        }
      },
      "description": "External identifiers of the same concept."
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "source",
                "ref"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "$ref": "#/$defs/slug"
                },
                "ref": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        }
      },
      "description": "Other names that other sources use for the same concept: reconciliation keys."
    },
    "popularity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "design_demand"
      ],
      "properties": {
        "score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "design_demand": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Relative prominence (`score`) and design demand (`design_demand`) within the dataset, in (0, 1)."
    },
    "relation_target": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "description": "A related entry, by id, with optional sources for the link.",
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "sources": {
          "$ref": "#/$defs/source_list"
        }
      }
    },
    "relations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/field"
      },
      "description": "Predicate (from `vocab.relations` for the entry's facet) to its target entries. A relation is stored once, on the entry of its owning facet.",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/relation_target"
        }
      }
    },
    "entry_base": {
      "description": "The fields every facet entry shares.",
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "tags",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "tags": {
          "$ref": "#/$defs/tag_list"
        },
        "sources": {
          "$ref": "#/$defs/source_list"
        },
        "domains": {
          "$ref": "#/$defs/domain_expressions"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/variant"
          }
        },
        "ids": {
          "$ref": "#/$defs/ids"
        },
        "aliases": {
          "$ref": "#/$defs/aliases"
        }
      }
    },
    "style": {
      "description": "A style, period, movement or culture with a distinct visual character.",
      "allOf": [
        {
          "$ref": "#/$defs/entry_base"
        }
      ],
      "required": [
        "parent",
        "domains"
      ],
      "properties": {
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/slug"
            },
            {
              "type": "null"
            }
          ],
          "description": "The broader style this style is a variant, sub-period or regional form of."
        },
        "popularity": {
          "$ref": "#/$defs/popularity"
        }
      },
      "unevaluatedProperties": false
    },
    "surface_entry_base": {
      "description": "The fields techniques and effects share: their look across domains in `markers`, and the relations they own.",
      "allOf": [
        {
          "$ref": "#/$defs/entry_base"
        }
      ],
      "required": [
        "markers"
      ],
      "properties": {
        "markers": {
          "$ref": "#/$defs/markers"
        },
        "relations": {
          "$ref": "#/$defs/relations"
        }
      }
    },
    "technique": {
      "description": "A process applied to a material or an object that sets its look (AAT Processes and Techniques).",
      "allOf": [
        {
          "$ref": "#/$defs/surface_entry_base"
        }
      ],
      "unevaluatedProperties": false
    },
    "effect": {
      "description": "A physical condition of a surface, made on purpose or by time (AAT Conditions and Effects).",
      "allOf": [
        {
          "$ref": "#/$defs/surface_entry_base"
        }
      ],
      "unevaluatedProperties": false
    },
    "facet": {
      "type": "object",
      "required": [
        "name",
        "description",
        "aat"
      ],
      "additionalProperties": false,
      "description": "A facet: a top-level class of concept, anchored on a Getty AAT facet or hierarchy.",
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "aat": {
          "anyOf": [
            {
              "$ref": "#/$defs/aat_id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "predicate": {
      "type": "object",
      "required": [
        "to",
        "inverse",
        "description"
      ],
      "additionalProperties": false,
      "description": "A relation predicate of one owning facet.",
      "properties": {
        "to": {
          "enum": [
            "styles",
            "techniques",
            "effects",
            "materials",
            "design_elements",
            "objects",
            "agents"
          ],
          "description": "The facet of the target entries."
        },
        "inverse": {
          "$ref": "#/$defs/field",
          "description": "The label of the reverse direction, as seen from a target entry."
        },
        "description": {
          "$ref": "#/$defs/description"
        }
      }
    },
    "empty_facet": {
      "type": "array",
      "maxItems": 0,
      "description": "A facet section with no entries."
    }
  }
}
